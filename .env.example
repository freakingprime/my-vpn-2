# ========================================================
# my-vpn-2 Environment Configuration Template
# Copy this file to .env and fill in your values
# ========================================================

# Web UI & HTTP/HTTPS Proxy Listening Ports
WEB_PORT=8080
PROXY_PORT=8888

# Target 2: Google Compute Engine (GCE) / VPS SSH Tunnel
GCE_HOST=203.0.113.10:22
GCE_USER=cloud-user
GCE_KEY_PATH=/data/id_rsa

# Automated Portainer Test Deployment (Optional, used by deploy-portainer.ps1)
PORTAINER_URL=https://192.168.1.100:9443
PORTAINER_API_KEY=your_portainer_api_key_here
PORTAINER_ENDPOINT_ID=1
NUC_DATA_DIR=/path/to/host/docker/my-vpn-2
LOCAL_SSH_KEY_PATH=~/.ssh/id_rsa
